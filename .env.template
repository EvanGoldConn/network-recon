# PoE Camera Recon Tool - Environment Configuration
# Copy to .env and fill in values

MODE=mock                              # mock | real

# LLM Models
AGENT_MODEL=qwen2.5:7b                 # Ollama model for discovery agent
ACCESS_MODEL=claude-haiku-4-5-20251001 # Anthropic model for access agent

# API Keys
ANTHROPIC_API_KEY=your_key_here
SHODAN_API_KEY=your_key_here           # https://account.shodan.io/

# Results encryption (leave blank to auto-generate on first run)
RESULTS_ENCRYPTION_KEY=


#Verbose
VERBOSE=false